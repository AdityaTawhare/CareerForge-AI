# ─── Server Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env!

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Get this from: https://mongodb.com/atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerforge?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Client ─────────────────────────────────────────────────────────────────
# Frontend URL (for CORS). No trailing slash.
CLIENT_URL=http://localhost:5173

# ─── AI Service ─────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── LLM Providers (fill in Phase 5) ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ─── Optional: Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: Email ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Optional: External APIs ────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GITHUB_TOKEN=
TAVILY_API_KEY=

# ─── Demo Mode ──────────────────────────────────────────────────────────────
DEMO_MODE=false
