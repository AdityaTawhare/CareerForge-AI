# ─── AI Service Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env!

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ─── Node Server (for internal calls) ───────────────────────────────────────
SERVER_URL=http://localhost:5000

# ─── LLM Providers ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Embedding Model ─────────────────────────────────────────────────────────
# Model downloaded from HuggingFace on first run (cached locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── MongoDB (for vector search, Phase 5+) ───────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerforge?retryWrites=true&w=majority

# ─── Demo Mode ───────────────────────────────────────────────────────────────
DEMO_MODE=false
